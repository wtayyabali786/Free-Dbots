import websocket
import json

API_TOKEN = "APNA_API_TOKEN"  # <-- Yahan apna Deriv API token dalen
URL = f"wss://ws.binaryws.com/websockets/v3?app_id=1089&l=EN"

bot_activated = False

def on_message(ws, message):
    global bot_activated
    data = json.loads(message)
    
    if "tick" in data:
        last_price = data["tick"]["quote"]
        last_digit = int(str(last_price)[-1])
        print(f"Current price: {last_price}, Last digit: {last_digit}")
        
        if not bot_activated:
            if last_digit == 1:
                bot_activated = True
                print("Bot activated ✅ - waiting for next tick")
        else:
            if last_digit == 2:
                print("Buying now 💰")
                # Yahan actual buy function call kar sakte hain
                # buy_contract()
            else:
                print("2 did not appear. Bot reset ❌")
            
            bot_activated = False

def on_open(ws):
    subscribe_msg = {
        "ticks": "R_100",
        "subscribe": 1
    }
    ws.send(json.dumps(subscribe_msg))

ws = websocket.WebSocketApp(URL,
                            on_message=on_message,
                            header=[f"Authorization: Bearer {API_TOKEN}"])

ws.run_forever()
